   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0009",
   "text": "Schön, dich zu sehen.",
   "meaning": "Good to see you.",
   "category": "Greetings",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0010",
   "text": "Lange nicht gesehen!",
   "meaning": "Long time no see!",
   "category": "Greetings",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0011",
   "text": "Bis später!",
   "meaning": "See you later!",
   "category": "Greetings",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0012",
   "text": "Bis morgen!",
   "meaning": "See you tomorrow!",
   "category": "Greetings",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0013",
   "text": "Tschüss!",
   "meaning": "Bye!",
   "category": "Greetings",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0014",
   "text": "Auf Wiedersehen!",
   "meaning": "Goodbye (formal)",
   "category": "Greetings",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0015",
   "text": "Gute Nacht!",
   "meaning": "Good night!",
   "category": "Greetings",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0016",
   "text": "Mach's gut!",
   "meaning": "Take care!",
   "category": "Greetings",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0017",
   "text": "Schönes Wochenende!",
   "meaning": "Have a nice weekend!",
   "category": "Greetings",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0018",
   "text": "Willkommen!",
   "meaning": "Welcome!",
   "category": "Greetings",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0019",
   "text": "Ich heiße Anna.",
   "meaning": "My name is Anna.",
   "category": "Introductions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0020",
   "text": "Wie heißt du?",
   "meaning": "What's your name?",
   "category": "Introductions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0021",
   "text": "Freut mich.",
   "meaning": "Nice to meet you.",
   "category": "Introductions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0022",
   "text": "Ich komme aus Norwegen.",
   "meaning": "I'm from Norway.",
   "category": "Introductions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0023",
   "text": "Woher kommst du?",
   "meaning": "Where are you from?",
   "category": "Introductions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0024",
   "text": "Ich wohne in Berlin.",
   "meaning": "I live in Berlin.",
   "category": "Introductions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0025",
   "text": "Wo wohnst du?",
   "meaning": "Where do you live?",
   "category": "Introductions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0026",
   "text": "Ich bin dreißig Jahre alt.",
   "meaning": "I'm thirty years old.",
   "category": "Introductions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0027",
   "text": "Ich lerne Deutsch.",
   "meaning": "I'm learning German.",
   "category": "Introductions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0028",
   "text": "Ich spreche noch nicht gut Deutsch.",
   "meaning": "I don't speak German well yet.",
   "category": "Introductions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0029",
   "text": "Sprichst du Englisch?",
   "meaning": "Do you speak English?",
   "category": "Introductions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0030",
   "text": "Was machst du beruflich?",
   "meaning": "What do you do for a living?",
   "category": "Introductions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0031",
   "text": "Entschuldigung!",
   "meaning": "Excuse me!",
   "category": "Getting by",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0032",
   "text": "Wie bitte?",
   "meaning": "Sorry, what?",
   "category": "Getting by",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0033",
   "text": "Kannst du das wiederholen?",
   "meaning": "Can you repeat that?",
   "category": "Getting by",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0034",
   "text": "Kannst du langsamer sprechen?",
   "meaning": "Can you speak more slowly?",
   "category": "Getting by",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0035",
   "text": "Was bedeutet das?",
   "meaning": "What does that mean?",
   "category": "Getting by",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0036",
   "text": "Wie sagt man das auf Deutsch?",
   "meaning": "How do you say that in German?",
   "category": "Getting by",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0037",
   "text": "Ich verstehe nicht.",
   "meaning": "I don't understand.",
   "category": "Getting by",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0038",
   "text": "Ich verstehe.",
   "meaning": "I understand.",
   "category": "Getting by",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0039",
   "text": "Ich weiß nicht.",
   "meaning": "I don't know.",
   "category": "Getting by",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0040",
   "text": "Keine Ahnung.",
   "meaning": "No idea.",
   "category": "Getting by",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0041",
   "text": "Moment, bitte.",
   "meaning": "One moment, please.",
   "category": "Getting by",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0042",
   "text": "Kannst du mir helfen?",
   "meaning": "Can you help me?",
   "category": "Getting by",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0043",
   "text": "Danke schön!",
   "meaning": "Thank you very much!",
   "category": "Getting by",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0044",
   "text": "Vielen Dank!",
   "meaning": "Many thanks!",
   "category": "Getting by",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0045",
   "text": "Bitte schön.",
   "meaning": "You're welcome.",
   "category": "Getting by",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0046",
   "text": "Gern geschehen.",
   "meaning": "My pleasure.",
   "category": "Getting by",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0047",
   "text": "Was kostet das?",
   "meaning": "How much is that?",
   "category": "Shops",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0048",
   "text": "Das ist zu teuer.",
   "meaning": "That's too expensive.",
   "category": "Shops",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0049",
   "text": "Haben Sie das in Größe M?",
   "meaning": "Do you have this in size M?",
   "category": "Shops",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0050",
   "text": "Ich schaue nur.",
   "meaning": "I'm just looking.",
   "category": "Shops",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0051",
   "text": "Ich nehme das.",
   "meaning": "I'll take it.",
   "category": "Shops",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0052",
   "text": "Kann ich mit Karte zahlen?",
   "meaning": "Can I pay by card?",
   "category": "Shops",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0053",
   "text": "Nur Bargeld, bitte.",
   "meaning": "Cash only, please.",
   "category": "Shops",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0054",
   "text": "Haben Sie eine Tüte?",
   "meaning": "Do you have a bag?",
   "category": "Shops",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0055",
   "text": "Wo ist die Kasse?",
   "meaning": "Where is the till?",
   "category": "Shops",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0056",
   "text": "Ich hätte gern eine Quittung.",
   "meaning": "I'd like a receipt.",
   "category": "Shops",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0057",
   "text": "Das ist alles, danke.",
   "meaning": "That's everything, thanks.",
   "category": "Shops",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0058",
   "text": "Ist das im Angebot?",
   "meaning": "Is that on offer?",
   "category": "Shops",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0059",
   "text": "Können Sie mir das zeigen?",
   "meaning": "Can you show me that?",
   "category": "Shops",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0060",
   "text": "Ich suche ein Geschenk.",
   "meaning": "I'm looking for a present.",
   "category": "Shops",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0061",
   "text": "Einen Kaffee, bitte.",
   "meaning": "A coffee, please.",
   "category": "Food and drink",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0062",
   "text": "Ich hätte gern einen Tee.",
   "meaning": "I'd like a tea.",
   "category": "Food and drink",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0063",
   "text": "Die Speisekarte, bitte.",
   "meaning": "The menu, please.",
   "category": "Food and drink",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0064",
   "text": "Was empfehlen Sie?",
   "meaning": "What do you recommend?",
   "category": "Food and drink",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0065",
   "text": "Ich nehme das Tagesgericht.",
   "meaning": "I'll have the dish of the day.",
   "category": "Food and drink",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0066",
   "text": "Ich bin Vegetarier.",
   "meaning": "I'm vegetarian.",
   "category": "Food and drink",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0067",
   "text": "Ohne Zwiebeln, bitte.",
   "meaning": "Without onions, please.",
   "category": "Food and drink",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0068",
   "text": "Noch ein Glas Wasser, bitte.",
   "meaning": "Another glass of water, please.",
   "category": "Food and drink",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0069",
   "text": "Guten Appetit!",
   "meaning": "Enjoy your meal!",
   "category": "Food and drink",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0070",
   "text": "Hat es geschmeckt?",
   "meaning": "Did you enjoy it?",
   "category": "Food and drink",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0071",
   "text": "Es war sehr lecker.",
   "meaning": "It was delicious.",
   "category": "Food and drink",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0072",
   "text": "Die Rechnung, bitte.",
   "meaning": "The bill, please.",
   "category": "Food and drink",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0073",
   "text": "Zusammen oder getrennt?",
   "meaning": "Together or separately?",
   "category": "Food and drink",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0074",
   "text": "Getrennt, bitte.",
   "meaning": "Separately, please.",
   "category": "Food and drink",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0075",
   "text": "Stimmt so.",
   "meaning": "Keep the change.",
   "category": "Food and drink",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0076",
   "text": "Ich habe einen Tisch reserviert.",
   "meaning": "I have a table booked.",
   "category": "Food and drink",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0077",
   "text": "Für zwei Personen, bitte.",
   "meaning": "For two people, please.",
   "category": "Food and drink",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0078",
   "text": "Ist dieser Platz frei?",
   "meaning": "Is this seat free?",
   "category": "Food and drink",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0079",
   "text": "Wann fährt der nächste Zug?",
   "meaning": "When does the next train leave?",
   "category": "Transport",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0080",
   "text": "Eine Fahrkarte nach Hamburg, bitte.",
   "meaning": "A ticket to Hamburg, please.",
   "category": "Transport",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0081",
   "text": "Einfach oder hin und zurück?",
   "meaning": "One way or return?",
   "category": "Transport",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0082",
