   "meaning": "Which platform does the train leave from?",
   "category": "Transport",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0083",
   "text": "Der Zug hat Verspätung.",
   "meaning": "The train is delayed.",
   "category": "Transport",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0084",
   "text": "Ich habe meinen Zug verpasst.",
   "meaning": "I missed my train.",
   "category": "Transport",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0085",
   "text": "Wo ist die Haltestelle?",
   "meaning": "Where is the stop?",
   "category": "Transport",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0086",
   "text": "Muss ich umsteigen?",
   "meaning": "Do I have to change?",
   "category": "Transport",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0087",
   "text": "Wie lange dauert die Fahrt?",
   "meaning": "How long does the journey take?",
   "category": "Transport",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0088",
   "text": "Ist dieser Platz besetzt?",
   "meaning": "Is this seat taken?",
   "category": "Transport",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0089",
   "text": "Können Sie mich hier absetzen?",
   "meaning": "Can you drop me off here?",
   "category": "Transport",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0090",
   "text": "Ich möchte ein Taxi bestellen.",
   "meaning": "I'd like to order a taxi.",
   "category": "Transport",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0091",
   "text": "Wie komme ich zum Bahnhof?",
   "meaning": "How do I get to the station?",
   "category": "Transport",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0092",
   "text": "Fährt dieser Bus zum Zentrum?",
   "meaning": "Does this bus go to the centre?",
   "category": "Transport",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0093",
   "text": "Ich steige hier aus.",
   "meaning": "I'm getting off here.",
   "category": "Transport",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0094",
   "text": "Bitte einsteigen!",
   "meaning": "All aboard!",
   "category": "Transport",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0095",
   "text": "Wo ist die Toilette?",
   "meaning": "Where is the toilet?",
   "category": "Directions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0096",
   "text": "Geradeaus, bitte.",
   "meaning": "Straight ahead, please.",
   "category": "Directions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0097",
   "text": "Links abbiegen.",
   "meaning": "Turn left.",
   "category": "Directions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0098",
   "text": "Rechts abbiegen.",
   "meaning": "Turn right.",
   "category": "Directions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0099",
   "text": "Es ist gleich um die Ecke.",
   "meaning": "It's just around the corner.",
   "category": "Directions",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0100",
   "text": "Ist es weit von hier?",
   "meaning": "Is it far from here?",
   "category": "Directions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0101",
   "text": "Ich habe mich verlaufen.",
   "meaning": "I'm lost.",
   "category": "Directions",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0102",
   "text": "Können Sie mir den Weg zeigen?",
   "meaning": "Can you show me the way?",
   "category": "Directions",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0103",
   "text": "Neben der Apotheke.",
   "meaning": "Next to the pharmacy.",
   "category": "Directions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0104",
   "text": "Gegenüber vom Bahnhof.",
   "meaning": "Opposite the station.",
   "category": "Directions",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0105",
   "text": "Ich habe heute viel zu tun.",
   "meaning": "I have a lot to do today.",
   "category": "Work",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0106",
   "text": "Ich bin in einer Besprechung.",
   "meaning": "I'm in a meeting.",
   "category": "Work",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0107",
   "text": "Können wir das morgen besprechen?",
   "meaning": "Can we discuss that tomorrow?",
   "category": "Work",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0108",
   "text": "Ich schicke dir eine E-Mail.",
   "meaning": "I'll send you an email.",
   "category": "Work",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0109",
   "text": "Ich melde mich später.",
   "meaning": "I'll get back to you later.",
   "category": "Work",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0110",
   "text": "Hast du kurz Zeit?",
   "meaning": "Do you have a minute?",
   "category": "Work",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0111",
   "text": "Das mache ich sofort.",
   "meaning": "I'll do that right away.",
   "category": "Work",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0112",
   "text": "Die Frist ist am Freitag.",
   "meaning": "The deadline is on Friday.",
   "category": "Work",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0113",
   "text": "Ich arbeite heute von zu Hause.",
   "meaning": "I'm working from home today.",
   "category": "Work",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0114",
   "text": "Ich bin im Urlaub.",
   "meaning": "I'm on holiday.",
   "category": "Work",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0115",
   "text": "Könnten Sie mir das erklären?",
   "meaning": "Could you explain that to me?",
   "category": "Work",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0116",
   "text": "Das ist kein Problem.",
   "meaning": "That's no problem.",
   "category": "Work",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0117",
   "text": "Ich kümmere mich darum.",
   "meaning": "I'll take care of it.",
   "category": "Work",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0118",
   "text": "Wir sehen uns im Büro.",
   "meaning": "See you at the office.",
   "category": "Work",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0119",
   "text": "Feierabend!",
   "meaning": "Done for the day!",
   "category": "Work",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0120",
   "text": "Schönen Feierabend!",
   "meaning": "Have a good evening after work!",
   "category": "Work",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0121",
   "text": "Ich muss noch einkaufen.",
   "meaning": "I still need to do the shopping.",
   "category": "At home",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0122",
   "text": "Ich räume die Küche auf.",
   "meaning": "I'm tidying the kitchen.",
   "category": "At home",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0123",
   "text": "Die Waschmaschine läuft.",
   "meaning": "The washing machine is running.",
   "category": "At home",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0124",
   "text": "Kannst du den Müll rausbringen?",
   "meaning": "Can you take the rubbish out?",
   "category": "At home",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0125",
   "text": "Ich koche heute Abend.",
   "meaning": "I'm cooking this evening.",
   "category": "At home",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0126",
   "text": "Das Licht ist noch an.",
   "meaning": "The light is still on.",
   "category": "At home",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0127",
   "text": "Ich gehe schlafen.",
   "meaning": "I'm going to bed.",
   "category": "At home",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0128",
   "text": "Ich stehe früh auf.",
   "meaning": "I get up early.",
   "category": "At home",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0129",
   "text": "Fühl dich wie zu Hause.",
   "meaning": "Make yourself at home.",
   "category": "At home",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0130",
   "text": "Es ist ziemlich unordentlich.",
   "meaning": "It's quite messy.",
   "category": "At home",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0131",
   "text": "Die Heizung funktioniert nicht.",
   "meaning": "The heating isn't working.",
   "category": "At home",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0132",
   "text": "Ich habe den Schlüssel vergessen.",
   "meaning": "I've forgotten the key.",
   "category": "At home",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0133",
   "text": "Mir geht es nicht gut.",
   "meaning": "I'm not feeling well.",
   "category": "Health",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0134",
   "text": "Ich habe Kopfschmerzen.",
   "meaning": "I have a headache.",
   "category": "Health",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0135",
   "text": "Ich bin erkältet.",
   "meaning": "I have a cold.",
   "category": "Health",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0136",
   "text": "Ich brauche einen Termin.",
   "meaning": "I need an appointment.",
   "category": "Health",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0137",
   "text": "Wo ist die nächste Apotheke?",
   "meaning": "Where's the nearest pharmacy?",
   "category": "Health",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0138",
   "text": "Gute Besserung!",
   "meaning": "Get well soon!",
   "category": "Health",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0139",
   "text": "Ich bin müde.",
   "meaning": "I'm tired.",
   "category": "Health",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0140",
   "text": "Ich muss mich ausruhen.",
   "meaning": "I need to rest.",
   "category": "Health",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0141",
   "text": "Haben Sie etwas gegen Husten?",
   "meaning": "Do you have something for a cough?",
   "category": "Health",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0142",
   "text": "Es tut hier weh.",
   "meaning": "It hurts here.",
   "category": "Health",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0143",
   "text": "Ich freue mich.",
   "meaning": "I'm glad.",
   "category": "Feelings",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0144",
   "text": "Ich freue mich darauf.",
   "meaning": "I'm looking forward to it.",
   "category": "Feelings",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0145",
   "text": "Das macht mir Spaß.",
   "meaning": "I enjoy that.",
   "category": "Feelings",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0146",
   "text": "Ich bin ein bisschen nervös.",
   "meaning": "I'm a little nervous.",
   "category": "Feelings",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0147",
   "text": "Ich bin sehr froh.",
   "meaning": "I'm very happy.",
   "category": "Feelings",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0148",
   "text": "Das ärgert mich.",
   "meaning": "That annoys me.",
   "category": "Feelings",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0149",
   "text": "Ich bin enttäuscht.",
   "meaning": "I'm disappointed.",
   "category": "Feelings",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0150",
   "text": "Ich habe Angst davor.",
   "meaning": "I'm afraid of it.",
   "category": "Feelings",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0151",
   "text": "Das ist mir egal.",
   "meaning": "I don't mind.",
   "category": "Feelings",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0152",
   "text": "Ich bin stolz auf dich.",
   "meaning": "I'm proud of you.",
   "category": "Feelings",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0153",
   "text": "Ich vermisse dich.",
   "meaning": "I miss you.",
   "category": "Feelings",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0154",
   "text": "Ich bin gestresst.",
   "meaning": "I'm stressed.",
   "category": "Feelings",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0155",
   "text": "Mir ist langweilig.",
   "meaning": "I'm bored.",
   "category": "Feelings",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0156",
   "text": "Das tut mir leid.",
   "meaning": "I'm sorry.",
   "category": "Feelings",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0157",
   "text": "Was machst du heute Abend?",
   "meaning": "What are you doing this evening?",
   "category": "Plans",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0158",
   "text": "Hast du am Wochenende Zeit?",
   "meaning": "Do you have time at the weekend?",
   "category": "Plans",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0159",
   "text": "Wollen wir einen Kaffee trinken?",
   "meaning": "Shall we have a coffee?",
   "category": "Plans",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0160",
   "text": "Ich habe schon etwas vor.",
   "meaning": "I already have plans.",
   "category": "Plans",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0161",
   "text": "Passt es dir um acht?",
   "meaning": "Does eight work for you?",
   "category": "Plans",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0162",
   "text": "Wir treffen uns um sieben.",
   "meaning": "We're meeting at seven.",
   "category": "Plans",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0163",
   "text": "Ich komme etwas später.",
   "meaning": "I'll be a bit late.",
   "category": "Plans",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0164",
   "text": "Ich muss leider absagen.",
   "meaning": "I'm afraid I have to cancel.",
   "category": "Plans",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0165",
   "text": "Vielleicht ein andermal.",
   "meaning": "Maybe another time.",
   "category": "Plans",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0166",
   "text": "Ich freue mich auf das Wochenende.",
   "meaning": "I'm looking forward to the weekend.",
   "category": "Plans",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0167",
   "text": "Lass uns spazieren gehen.",
   "meaning": "Let's go for a walk.",
   "category": "Plans",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0168",
   "text": "Hast du Lust, ins Kino zu gehen?",
   "meaning": "Do you fancy going to the cinema?",
   "category": "Plans",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0169",
   "text": "Ich rufe dich später an.",
   "meaning": "I'll call you later.",
   "category": "Plans",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0170",
   "text": "Schreib mir einfach.",
   "meaning": "Just text me.",
   "category": "Plans",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0171",
   "text": "Ich finde das gut.",
   "meaning": "I think that's good.",
   "category": "Opinions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0172",
   "text": "Was hältst du davon?",
   "meaning": "What do you think of it?",
   "category": "Opinions",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0173",
   "text": "Meiner Meinung nach ist das richtig.",
   "meaning": "In my opinion that's right.",
   "category": "Opinions",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0174",
   "text": "Ich bin nicht sicher.",
   "meaning": "I'm not sure.",
   "category": "Opinions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0175",
   "text": "Das kommt darauf an.",
   "meaning": "That depends.",
   "category": "Opinions",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0176",
   "text": "Ich sehe das anders.",
   "meaning": "I see it differently.",
   "category": "Opinions",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0177",
   "text": "Da hast du recht.",
   "meaning": "You're right there.",
   "category": "Opinions",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0178",
   "text": "Genau!",
   "meaning": "Exactly!",
   "category": "Opinions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0179",
   "text": "Das stimmt.",
   "meaning": "That's true.",
   "category": "Opinions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0180",
   "text": "Das stimmt nicht.",
   "meaning": "That's not true.",
   "category": "Opinions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0181",
   "text": "Ich glaube schon.",
   "meaning": "I think so.",
   "category": "Opinions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0182",
   "text": "Ich glaube nicht.",
   "meaning": "I don't think so.",
   "category": "Opinions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0183",
   "text": "Einerseits ja, andererseits nein.",
   "meaning": "On the one hand yes, on the other no.",
   "category": "Opinions",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0184",
   "text": "Ehrlich gesagt gefällt es mir nicht.",
   "meaning": "Honestly, I don't like it.",
   "category": "Opinions",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0185",
   "text": "Das ist Geschmackssache.",
   "meaning": "That's a matter of taste.",
   "category": "Opinions",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0186",
   "text": "Ich kann das gut verstehen.",
   "meaning": "I can understand that.",
   "category": "Opinions",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0187",
   "text": "Wirklich?",
   "meaning": "Really?",
   "category": "Reactions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0188",
   "text": "Ach so!",
   "meaning": "Oh, I see!",
   "category": "Reactions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0189",
   "text": "Na klar!",
   "meaning": "Of course!",
   "category": "Reactions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0190",
   "text": "Kein Problem.",
   "meaning": "No problem.",
   "category": "Reactions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0191",
   "text": "Alles klar.",
   "meaning": "All good.",
   "category": "Reactions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0192",
   "text": "Schade!",
   "meaning": "What a shame!",
   "category": "Reactions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0193",
   "text": "Wie schön!",
   "meaning": "How lovely!",
   "category": "Reactions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0194",
   "text": "Das ist ja toll!",
   "meaning": "That's great!",
   "category": "Reactions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0195",
   "text": "Oh je!",
   "meaning": "Oh dear!",
   "category": "Reactions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0196",
   "text": "Im Ernst?",
   "meaning": "Seriously?",
   "category": "Reactions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0197",
   "text": "Na ja ...",
   "meaning": "Well ...",
   "category": "Reactions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0198",
   "text": "Also, ich meine ...",
   "meaning": "Well, I mean ...",
   "category": "Reactions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0199",
   "text": "Moment mal!",
   "meaning": "Hang on a second!",
   "category": "Reactions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0200",
   "text": "Das glaube ich nicht!",
   "meaning": "I don't believe it!",
   "category": "Reactions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0201",
   "text": "Viel Glück!",
   "meaning": "Good luck!",
   "category": "Reactions",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0202",
   "text": "Herzlichen Glückwunsch!",
   "meaning": "Congratulations!",
   "category": "Reactions",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0203",
   "text": "Entschuldigen Sie bitte.",
   "meaning": "Excuse me, please. (formal)",
   "category": "Politeness",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0204",
   "text": "Das war meine Schuld.",
   "meaning": "That was my fault.",
   "category": "Politeness",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0205",
   "text": "Ich wollte das nicht.",
   "meaning": "I didn't mean to.",
   "category": "Politeness",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0206",
   "text": "Kein Grund zur Sorge.",
   "meaning": "No need to worry.",
   "category": "Politeness",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0207",
   "text": "Darf ich Sie etwas fragen?",
   "meaning": "May I ask you something?",
   "category": "Politeness",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0208",
   "text": "Würden Sie mir bitte helfen?",
   "meaning": "Would you help me, please?",
   "category": "Politeness",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0209",
   "text": "Könnten Sie das bitte wiederholen?",
   "meaning": "Could you repeat that, please?",
   "category": "Politeness",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0210",
   "text": "Vielen Dank für Ihre Hilfe.",
   "meaning": "Thank you for your help.",
   "category": "Politeness",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0211",
   "text": "Nichts zu danken.",
   "meaning": "Don't mention it.",
   "category": "Politeness",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0212",
   "text": "Entschuldigung für die Verspätung.",
   "meaning": "Sorry for being late.",
   "category": "Politeness",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0213",
   "text": "Schönes Wetter heute!",
   "meaning": "Lovely weather today!",
   "category": "Weather",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0214",
   "text": "Es regnet schon wieder.",
   "meaning": "It's raining again.",
   "category": "Weather",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0215",
   "text": "Es ist ziemlich kalt draußen.",
   "meaning": "It's quite cold outside.",
   "category": "Weather",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0216",
   "text": "Die Sonne scheint.",
   "meaning": "The sun is shining.",
   "category": "Weather",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0217",
   "text": "Es schneit!",
   "meaning": "It's snowing!",
   "category": "Weather",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0218",
   "text": "Was für ein Wetter!",
   "meaning": "What weather!",
   "category": "Weather",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0219",
   "text": "Es soll morgen wärmer werden.",
   "meaning": "It's supposed to get warmer tomorrow.",
   "category": "Weather",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0220",
   "text": "Ich mag den Herbst.",
   "meaning": "I like autumn.",
   "category": "Weather",
   "level": 1,
   "cefr": "A1"
  },
  {
   "id": "de-0221",
   "text": "Der Sommer war toll.",
   "meaning": "The summer was great.",
   "category": "Weather",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0222",
   "text": "Nimm einen Schirm mit.",
   "meaning": "Take an umbrella with you.",
   "category": "Weather",
   "level": 2,
   "cefr": "A2"
  },
  {
   "id": "de-0223",
   "text": "Könntest du mir kurz helfen?",
   "meaning": "Could you help me for a moment?",
   "category": "Plans",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0224",
   "text": "Es wäre schön, wenn du mitkommen könntest.",
   "meaning": "It would be nice if you could come along.",
   "category": "Plans",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0225",
   "text": "Ich bin mir noch nicht sicher, ob das klappt.",
   "meaning": "I'm not sure yet whether that will work.",
   "category": "Plans",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0226",
   "text": "Kannst du mir sagen, wann du ankommst?",
   "meaning": "Can you tell me when you arrive?",
   "category": "Plans",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0227",
   "text": "Lass uns das morgen weitermachen.",
   "meaning": "Let's carry on with that tomorrow.",
   "category": "Plans",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0228",
   "text": "Das klingt nach einem guten Plan.",
   "meaning": "That sounds like a good plan.",
   "category": "Plans",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0229",
   "text": "Ich bin gerade unterwegs.",
   "meaning": "I'm on my way right now.",
   "category": "Plans",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0230",
   "text": "Ich würde gern einen Termin vereinbaren.",
   "meaning": "I'd like to arrange an appointment.",
   "category": "Work",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0231",
   "text": "Wir sollten das bald besprechen.",
   "meaning": "We should discuss that soon.",
   "category": "Work",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0232",
   "text": "Ich melde mich, sobald ich mehr weiß.",
   "meaning": "I'll be in touch as soon as I know more.",
   "category": "Work",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0233",
   "text": "Könnten wir das auf nächste Woche verschieben?",
   "meaning": "Could we postpone that to next week?",
   "category": "Work",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0234",
   "text": "Ich wollte nur kurz nachfragen.",
   "meaning": "I just wanted to check quickly.",
   "category": "Work",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0235",
   "text": "Ich bin noch nicht dazu gekommen.",
   "meaning": "I haven't got round to it yet.",
   "category": "Work",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0236",
   "text": "Darf ich kurz unterbrechen?",
   "meaning": "May I interrupt for a moment?",
   "category": "Work",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0237",
   "text": "Ich habe vergessen, dir Bescheid zu sagen.",
   "meaning": "I forgot to let you know.",
   "category": "Getting by",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0238",
   "text": "Mir ist aufgefallen, dass etwas fehlt.",
   "meaning": "I noticed that something is missing.",
   "category": "Getting by",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0239",
   "text": "Das habe ich anders verstanden.",
   "meaning": "I understood that differently.",
   "category": "Getting by",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0240",
   "text": "Ich versuche, mehr Deutsch zu sprechen.",
   "meaning": "I'm trying to speak more German.",
   "category": "Getting by",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0241",
   "text": "Ich habe mich daran gewöhnt.",
   "meaning": "I've got used to it.",
   "category": "Getting by",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0242",
   "text": "Das hängt davon ab, wie viel Zeit ich habe.",
   "meaning": "That depends on how much time I have.",
   "category": "Opinions",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0243",
   "text": "Es kommt immer darauf an, wen man fragt.",
   "meaning": "It always depends who you ask.",
   "category": "Opinions",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0244",
   "text": "Ich hätte das nicht gedacht.",
   "meaning": "I wouldn't have thought that.",
   "category": "Opinions",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0245",
   "text": "Das ist mir noch nie passiert.",
   "meaning": "That has never happened to me before.",
   "category": "Feelings",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0246",
   "text": "Ich habe den ganzen Tag nichts gegessen.",
   "meaning": "I haven't eaten all day.",
   "category": "Feelings",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0247",
   "text": "Ich möchte mich für die Verspätung entschuldigen.",
   "meaning": "I'd like to apologise for the delay.",
   "category": "Politeness",
   "level": 3,
   "cefr": "B1"
  },
  {
   "id": "de-0248",
   "text": "Ich würde es anders formulieren.",
   "meaning": "I'd put it differently.",
   "category": "Opinions",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0249",
   "text": "Das halte ich für übertrieben.",
   "meaning": "I think that's exaggerated.",
   "category": "Opinions",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0250",
   "text": "Ich kann mich dem nur anschließen.",
   "meaning": "I can only agree with that.",
   "category": "Opinions",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0251",
   "text": "Es spricht einiges dafür.",
   "meaning": "There's a good deal to be said for it.",
   "category": "Opinions",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0252",
   "text": "Im Großen und Ganzen bin ich zufrieden.",
   "meaning": "On the whole I'm satisfied.",
   "category": "Opinions",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0253",
   "text": "Das kann man so oder so sehen.",
   "meaning": "You can see that either way.",
   "category": "Opinions",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0254",
   "text": "Ich möchte das nicht verallgemeinern.",
   "meaning": "I don't want to generalise.",
   "category": "Opinions",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0255",
   "text": "Da bin ich ganz bei dir.",
   "meaning": "I'm completely with you on that.",
   "category": "Opinions",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0256",
   "text": "Es lohnt sich, darüber nachzudenken.",
   "meaning": "It's worth thinking about.",
   "category": "Opinions",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0257",
   "text": "Das lässt sich sicher einrichten.",
   "meaning": "That can surely be arranged.",
   "category": "Work",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0258",
   "text": "Darauf möchte ich später zurückkommen.",
   "meaning": "I'd like to come back to that later.",
   "category": "Work",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0259",
   "text": "Ich sehe da durchaus Verbesserungspotenzial.",
   "meaning": "I do see room for improvement there.",
   "category": "Work",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0260",
   "text": "Ich habe mich wohl missverständlich ausgedrückt.",
   "meaning": "I must have expressed myself unclearly.",
   "category": "Work",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0261",
   "text": "Ich würde ungern etwas versprechen.",
   "meaning": "I'd rather not promise anything.",
   "category": "Work",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0262",
   "text": "Mir fällt das Wort gerade nicht ein.",
   "meaning": "The word escapes me right now.",
   "category": "Getting by",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0263",
   "text": "Das kommt mir bekannt vor.",
   "meaning": "That sounds familiar.",
   "category": "Getting by",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0264",
   "text": "Es sei denn, du hast eine bessere Idee.",
   "meaning": "Unless you have a better idea.",
   "category": "Getting by",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0265",
   "text": "Vorausgesetzt, es klappt mit dem Zug.",
   "meaning": "Provided it works out with the train.",
   "category": "Getting by",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0266",
   "text": "Ich bin hin- und hergerissen.",
   "meaning": "I'm torn.",
   "category": "Feelings",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0267",
   "text": "Das hat mich wirklich überrascht.",
   "meaning": "That really surprised me.",
   "category": "Feelings",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0268",
   "text": "Ich bin mir dessen bewusst.",
   "meaning": "I'm aware of that.",
   "category": "Feelings",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0269",
   "text": "Ich lasse mich gern überraschen.",
   "meaning": "I'm happy to be surprised.",
   "category": "Feelings",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0270",
   "text": "Ich habe mich darauf eingestellt.",
   "meaning": "I've prepared myself for that.",
   "category": "Feelings",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0271",
   "text": "Es hat sich herausgestellt, dass es stimmt.",
   "meaning": "It turned out to be true.",
   "category": "Reactions",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0272",
   "text": "Ich habe den Eindruck, dass etwas nicht stimmt.",
   "meaning": "I get the impression something is wrong.",
   "category": "Reactions",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0273",
   "text": "Das war mir so nicht bewusst.",
   "meaning": "I wasn't aware of that.",
   "category": "Reactions",
   "level": 4,
   "cefr": "B2"
  },
  {
   "id": "de-0274",
   "text": "Darüber lässt sich streiten.",
   "meaning": "That's debatable.",
   "category": "Opinions",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0275",
   "text": "Das ist mit Vorsicht zu genießen.",
   "meaning": "That should be taken with a pinch of salt.",
   "category": "Opinions",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0276",
   "text": "Das steht auf einem anderen Blatt.",
   "meaning": "That's another matter entirely.",
   "category": "Opinions",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0277",
   "text": "Ich würde es dabei belassen.",
   "meaning": "I'd leave it at that.",
   "category": "Opinions",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0278",
   "text": "Das würde den Rahmen sprengen.",
   "meaning": "That would go beyond the scope.",
   "category": "Opinions",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0279",
   "text": "Das stand so nicht zur Debatte.",
   "meaning": "That wasn't up for discussion.",
   "category": "Opinions",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0280",
   "text": "Das liegt mir fern.",
   "meaning": "Nothing could be further from my intention.",
   "category": "Politeness",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0281",
   "text": "Ich möchte dem nicht vorgreifen.",
   "meaning": "I don't want to pre-empt that.",
   "category": "Politeness",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0282",
   "text": "Das nehme ich dir nicht übel.",
   "meaning": "I don't hold that against you.",
   "category": "Politeness",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0283",
   "text": "Das war nicht böse gemeint.",
   "meaning": "That wasn't meant unkindly.",
   "category": "Politeness",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0284",
   "text": "Es bleibt abzuwarten, wie es ausgeht.",
   "meaning": "It remains to be seen how it turns out.",
   "category": "Reactions",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0285",
   "text": "Das kannst du laut sagen.",
   "meaning": "You can say that again.",
   "category": "Reactions",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0286",
   "text": "Das ist leichter gesagt als getan.",
   "meaning": "That's easier said than done.",
   "category": "Reactions",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0287",
   "text": "Nun mal halblang!",
   "meaning": "Steady on!",
   "category": "Reactions",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0288",
   "text": "Ich lasse mir das durch den Kopf gehen.",
   "meaning": "I'll mull it over.",
   "category": "Plans",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0289",
   "text": "Wir sollten die Kirche im Dorf lassen.",
   "meaning": "Let's not get carried away.",
   "category": "Plans",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0290",
   "text": "Ich halte mich da lieber raus.",
   "meaning": "I'd rather stay out of it.",
   "category": "Plans",
   "level": 5,
   "cefr": "C1"
  },
  {
   "id": "de-0291",
   "text": "Es hält sich in Grenzen.",
   "meaning": "It's within limits.",
   "category": "Plans",
   "level": 5,
   "cefr": "C1"
  }
 ]
}
