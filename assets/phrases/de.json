   "text": "Wie geht es dir?",
   "meaning": "How are you? (informal)",
   "category": "Greetings",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0006",
   "text": "Wie geht es Ihnen?",
   "meaning": "How are you? (formal)",
   "category": "Greetings",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0007",
   "text": "Mir geht es gut, danke.",
   "meaning": "I'm well, thanks.",
   "category": "Greetings",
   "level": 0,
   "cefr": "A1"
  },
  {
   "id": "de-0008",
